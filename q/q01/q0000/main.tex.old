\nextq
Compute $\frac{d}{dx} \left(  x^3 \sin x + \frac{1}{2} x \right)$.
\\
\ANSWER
\begin{answerlong}
\begin{align*}
\frac{d}{dx} \left(  x^3 \sin x + \frac{1}{2} x \right)
  &=  \frac{d}{dx} x^3 \sin x + \frac{d}{dx} \left( ? \right) & & \text{by the addition rule}
  \\
  &=  \left( \frac{d}{dx} ? \right) \sin x                         
      + x^3 \left( \frac{d}{dx} ? \right)
      + ? & & \text{by the ? rule}
      \\
  &=  ? + ? + ?
\end{align*}
\end{answerlong}

